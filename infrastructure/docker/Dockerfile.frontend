# Multi-stage: the React app is built inside Docker, so a fresh clone needs no local Node install.
ARG NODE_IMAGE=node:22-alpine
ARG NGINX_RUNTIME=nginxinc/nginx-unprivileged:stable-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /app
# Dependencies first: this layer is cached until package-lock.json changes.
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM ${NGINX_RUNTIME}
COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY infrastructure/docker/security-headers.conf /etc/nginx/snippets/security-headers.conf
USER 101
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
