ARG JAVA_RUNTIME=eclipse-temurin:17-jre-alpine
FROM ${JAVA_RUNTIME}
WORKDIR /app
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \n    && mkdir -p /app/uploads && chown appuser:appgroup /app/uploads
COPY --chown=appuser:appgroup target/*.jar app.jar
USER appuser
EXPOSE 8082
ENTRYPOINT ["java", "-Xms64m", "-Xmx256m", "-jar", "app.jar"]
