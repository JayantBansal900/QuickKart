{
  "compilerOptions": {
    "target": "ES2022",

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "module": "ESNext",
    "moduleResolution": "bundler",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "jsx": "react-jsx",

    "paths": {
      "@/*": [
        "./*"
      ]
    },

    "allowJs": true,
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true
  }
}