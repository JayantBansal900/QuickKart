# QuickKart Environment Variables Configuration Template
# Copy this file to .env for local overrides (DO NOT commit .env containing real credentials)

# ==================================================
# 1. PostgreSQL Database Configuration
# ==================================================
POSTGRES_DB=quickkart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quickkart
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ==================================================
# 2. Redis Distributed Cache & Lock Configuration
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300000

# ==================================================
# 3. Apache Kafka Event Stream Configuration
# ==================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDER_EVENTS=quickkart.order-events
KAFKA_CONSUMER_GROUP=quickkart-order-notifications
KAFKA_EMBEDDED_ENABLED=true

# ==================================================
# 4. Security & JWT Configuration
# ==================================================
# Base64 or 256-bit secret key for signing JWT tokens
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Development admin account (dev profile only). To use the admin panel, set DEV_ADMIN_ENABLED=true
# and a password of at least 12 characters.
DEV_ADMIN_ENABLED=false
DEV_ADMIN_NAME=QuickKart Admin
DEV_ADMIN_EMAIL=admin@quickkart.com
DEV_ADMIN_PASSWORD=

# ==================================================
# 5. Microservice Service URLs (API Gateway Proxy)
# ==================================================
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
MONOLITH_SERVICE_URL=http://localhost:8081

# ==================================================
# 6. Active Spring Profile
# ==================================================
# Options: dev, prod
SPRING_PROFILES_ACTIVE=dev

# Generate independent Base64 keys using a cryptographic RNG (at least 32 bytes each).
OTP_HASH_SECRET=
# Seed the 535-product catalog into an empty database (dev profile only; inserts missing SKUs,
# never overwrites). The prod profile always disables it.
DEV_PRODUCTS_ENABLED=true
DEV_TOOLS_ENABLED=false
# Email delivery for OTP codes.
#   MAIL_TRANSPORT=console -> dev only: the code is printed in the monolith log
#   MAIL_TRANSPORT=smtp    -> real email (the prod profile always uses smtp)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME/SMTP_FROM=your address,
#        SMTP_PASSWORD=a 16-letter App Password (Google Account > Security > App passwords), no spaces.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
